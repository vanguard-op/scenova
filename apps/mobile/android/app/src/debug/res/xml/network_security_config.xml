<?xml version="1.0" encoding="utf-8"?>
<!--
  Development transport rule for the local stack.

  The local services the `Makefile` boots are plaintext HTTP, and the Android
  emulator reaches the developer's machine at 10.0.2.2. Cleartext stays confined
  to those local hosts: any other host keeps the platform's default and must use
  TLS, so the reader's selection is never sent in the clear to a remote gateway
  (NFR-022, no mixed content).

  This file is in the debug source set, so it overrides the app's default
  network-security policy for debug builds only; profile and release builds
  never permit cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

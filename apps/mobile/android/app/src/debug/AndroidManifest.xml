<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The local stack the `Makefile` boots is served over plaintext, and the
         emulator reaches it at 10.0.2.2. A debug build permits cleartext for
         those hosts only; every other build keeps the platform default and
         refuses cleartext, so reader input is never sent in the clear to a
         remote gateway (NFR-022). -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>

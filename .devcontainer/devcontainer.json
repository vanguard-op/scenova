{
  "name": "Scenova",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "FLUTTER_VERSION": "3.47.2",
      "ANDROID_CMDLINE_TOOLS_VERSION": "13114758"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.5"
    },
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {}
  },
  "containerEnv": {
    "ENVIRONMENT": "dev"
  },
  "postCreateCommand": "make setup && npm install -g firebase-tools@15",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-python.python",
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter"
      }
    }
  }
}

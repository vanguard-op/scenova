# Scenova environment schema — the single source of truth for configuration.
#
# Every variable the services, the AI layer, and the deploy path read is declared
# here with a placeholder. Copy to `.env` for local work (`make setup` does this)
# and fill real values locally; `.env` is gitignored and never committed.
#
# In the cloud these values are supplied per environment (dev/staging/prod) from
# Secret Manager and Cloud Run environment variables, wired by `infra/terraform`.
# Variable names here and the Terraform variable names are the same on purpose:
# one name, one meaning, everywhere.
#
# NOTE: no inline comments — this file is `include`d by the Makefile, and a
# trailing `# ...` would become part of the value.

# --- Runtime -----------------------------------------------------------------
# ENVIRONMENT: dev | staging | prod
ENVIRONMENT=dev
# LOG_LEVEL: debug | info | warning | error
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id

# --- Google Cloud ------------------------------------------------------------
GCP_PROJECT_ID=scenova-dev
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=scenova
GCP_RUNTIME_SERVICE_ACCOUNT=scenova-gateway@scenova-dev.iam.gserviceaccount.com
# Audience asserted on internal service-to-service calls (C-003, C-004, C-005).
INTERNAL_AUDIENCE=scenova-internal

# --- Primary database (Cloud SQL for PostgreSQL) -----------------------------
# Local: point at docker-compose Postgres. Cloud: injected from Secret Manager.
DATABASE_URL=postgresql+psycopg://scenova:scenova@localhost:5432/scenova
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scenova
DB_USER=scenova
# Secret — local placeholder only.
DB_PASSWORD=

# --- Cache and queue (Memorystore Redis + Cloud Tasks) -----------------------
REDIS_URL=redis://localhost:6379/0
TASKS_PROJECT=scenova-dev
TASKS_LOCATION=us-central1
TASKS_QUEUE=generation-jobs
TASKS_INVOKER_SERVICE_ACCOUNT=scenova-tasks@scenova-dev.iam.gserviceaccount.com

# --- Object storage and CDN (Cloud Storage + Cloud CDN) ----------------------
CLIP_BUCKET=scenova-clips-dev
CLIP_CDN_BASE_URL=https://cdn.scenova.example
CLIP_URL_TTL_SECONDS=900

# --- Identity (Firebase Authentication) --------------------------------------
FIREBASE_PROJECT_ID=scenova-dev
# Local auth uses Application Default Credentials from `gcloud auth
# application-default login`; do not set GOOGLE_APPLICATION_CREDENTIALS to an
# empty value, which breaks ADC.

# --- Model provider (Gemini API, two pins) -----------------------------------
# The generation path pins two model versions and no others (architecture
# "Model Version & Fallback"): the gloss phrase is a text capability pinned to
# its text model (NFR-050), and the clip is a video capability pinned to its
# video model (NFR-051, NFR-053). An upgrade of either is a new pin after a fresh
# golden-set evaluation, never a per-environment knob.
PHRASE_MODEL_PIN=gemini-3.5-flash-lite
CLIP_MODEL_PIN=gemini-omni-1.1-flash
# When each pin was settled (UTC ISO-8601); moves with a qualified replacement.
PHRASE_MODEL_PINNED_AT=2026-10-12T00:00:00+00:00
CLIP_MODEL_PINNED_AT=2026-10-12T00:00:00+00:00
# Secret — local placeholder only.
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Payments (RevenueCat) ---------------------------------------------------
# Secrets — local placeholders only.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# --- Analytics ---------------------------------------------------------------
# Sink identifier; raw events carry no personal data.
ANALYTICS_EVENT_STORE=
ANALYTICS_CONSENT_GATED_EVENTS=lookup_started,clip_played,history_viewed

# --- Push notifications (Firebase Cloud Messaging) ----------------------------
# The notification service delivers the clip-ready notice (FEAT-008) to the
# device token the client registered (C-008). The provider is Firebase Cloud
# Messaging behind the Firebase project already used for identity
# (FIREBASE_PROJECT_ID). A send is authorized by a short-lived OAuth 2.0 token
# from Application Default Credentials, so there is no secret here; in the cloud
# the runtime service account is granted the send role and no other service is.
PUSH_PROVIDER=firebase
PUSH_FCM_BASE_URL=https://fcm.googleapis.com

# --- Feature flags (release.md Rollout Phases) -------------------------------
# Runtime kill switches. Cloud values are the source of truth per environment.
FLAG_ENABLE_CLIP_VIEW=false
FLAG_ENABLE_GENERATION=false
FLAG_ENABLE_PHRASE_CLIP=false
FLAG_ENABLE_OFFLINE_HISTORY=false
FLAG_ENABLE_PAID_TIER=false
FLAG_SERVE_SEEDED_LIBRARY=true

# --- Local ports (docker-compose / make boot) --------------------------------
GATEWAY_PORT=8080
LOOKUP_PORT=8081
PIPELINE_PORT=8082
LIBRARY_PORT=8083
ENTITLEMENT_PORT=8084
FEEDBACK_PORT=8085
ANALYTICS_PORT=8086
NOTIFICATION_PORT=8087
MODEL_PORT=8090

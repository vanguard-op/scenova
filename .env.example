# Scenova environment schema — the single source of truth for configuration.
#
# Every variable the services, the AI layer, and the deploy path read is declared
# here with a placeholder. Copy to `.env` for local work (`make setup` does this)
# and fill real values locally; `.env` is gitignored and never committed.
#
# In the cloud these values are supplied per environment (dev/staging/prod) from
# Secret Manager and Cloud Run environment variables, wired by `infra/terraform`.
# Variable names here and the Terraform variable names are the same on purpose:
# one name, one meaning, everywhere.
#
# NOTE: no inline comments — this file is `include`d by the Makefile, and a
# trailing `# ...` would become part of the value.
#
# The schema is checked in CI (`make env`): the release flags and their defaults
# come from release.md "Rollout Phases & Feature Flags", and the clip-store keys
# from architecture.md "Data Architecture".

# --- Runtime -----------------------------------------------------------------
# ENVIRONMENT: dev | staging | prod
ENVIRONMENT=dev
# LOG_LEVEL: debug | info | warning | error
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id

# --- Google Cloud ------------------------------------------------------------
# The one project identifier for local work: the Firebase project (the token
# audience the services verify and the FCM target the notification service sends
# to) and the Cloud Tasks project are the same Google project. FIREBASE_PROJECT_ID
# and TASKS_PROJECT are declared below with this same value so a service started
# straight from `.env` resolves them; `make env` fails if any of the three
# diverge; and the Makefile and ci/lib.sh re-derive them from this value so the
# running stack always uses it. A mismatch would reject every valid Firebase
# token with a 401 or point FCM at the wrong project. The per-cloud-environment
# projects live in infra/terraform/environments/<env>.tfvars, not here.
GCP_PROJECT_ID=scenova-hq
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=scenova
GCP_RUNTIME_SERVICE_ACCOUNT=scenova-gateway@scenova-dev.iam.gserviceaccount.com
# Audience asserted on internal service-to-service calls (C-003, C-004, C-005).
INTERNAL_AUDIENCE=scenova-internal

# --- Primary database (Cloud SQL for PostgreSQL) -----------------------------
# The relational store the docs define (architecture.md "Data Architecture":
# accounts, entitlements, library entry metadata, review records, feedback;
# schema.md "Entities"). One name for the connection string in both places:
#   Local : DATABASE_URL points at the docker-compose Postgres (`make db-up`),
#           and the DB_* parts are what docker-compose reads to create it.
#   Cloud : DATABASE_URL is injected from Secret Manager by infra/terraform; the
#           instance (private IP, backups, point-in-time recovery, HA in prod)
#           lives in infra/terraform/modules/data.
# The schema is the migration history under infra/db/migrations, applied by
# `make db-migrate` locally and by the Cloud SQL migration job in the cloud
# (`make db-migrate-cloud ENV=…`); `make db-check` applies, rolls back, and
# re-applies it against a throwaway PostgreSQL.
DATABASE_URL=postgresql+psycopg://scenova:scenova@localhost:5432/scenova
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scenova
DB_USER=scenova
# Secret — local placeholder only.
DB_PASSWORD=

# --- Cache and queue (Memorystore Redis + Cloud Tasks) -----------------------
REDIS_URL=redis://localhost:6379/0
# The same Google project as GCP_PROJECT_ID; `make env` fails if it diverges.
TASKS_PROJECT=scenova-hq
TASKS_LOCATION=us-central1
TASKS_QUEUE=generation-jobs
TASKS_INVOKER_SERVICE_ACCOUNT=scenova-tasks@scenova-dev.iam.gserviceaccount.com

# --- Object storage and CDN (Cloud Storage + Cloud CDN) ----------------------
# Clip files for the shared library and card-sized renditions (architecture.md
# "Data Architecture": write-once, read-many, behind the delivery network).
CLIP_BUCKET=scenova-clips-dev
CLIP_CDN_BASE_URL=https://cdn.scenova.example
CLIP_URL_TTL_SECONDS=900
# The store the model layer writes clips to and serves them from: gcs | local.
# Empty resolves per environment — local in development, gcs everywhere else — so
# a local run keeps clips on its own filesystem and the cloud always uses the
# bucket; gcs stays the cloud default so a stray local value cannot redirect
# production storage.
CLIP_STORE_BACKEND=local
# Address a locally served clip is fetched from; the host loopback by default.
# An Android emulator reaches the host through 10.0.2.2 and overrides this.
CLIP_LOCAL_BASE_URL=http://localhost:8090
# Directory a locally served clip is written to. Empty uses the platform
# temporary directory.
CLIP_LOCAL_DIR=

# --- Identity (Firebase Authentication) --------------------------------------
# The Firebase project the services verify tokens against and the project FCM
# sends to; the same Google project as GCP_PROJECT_ID, and `make env` fails if it
# diverges. Declared here so a service started straight from `.env` resolves it,
# because the services read FIREBASE_PROJECT_ID directly from the environment.
FIREBASE_PROJECT_ID=scenova-hq
#
# Local auth uses Application Default Credentials: run `make auth` once to sign
# in and point the ADC quota project at the project (Remote Config and other
# Firebase APIs refuse a user credential with no quota project). Do not set
# GOOGLE_APPLICATION_CREDENTIALS to an empty value, which breaks ADC.
#
# A local run that verifies real Firebase ID tokens sets AUTH_MODE=firebase; the
# default dev verifier accepts pseudonymous `dev:<subject>` tokens and is what
# the test harness uses.

# --- Model provider (Gemini API, two pins) -----------------------------------
# The generation path pins two model versions and no others (architecture
# "Model Version & Fallback"): the gloss phrase is a text capability pinned to
# its text model (NFR-050), and the clip is a video capability pinned to its
# video model (NFR-051, NFR-053). An upgrade of either is a new pin after a fresh
# golden-set evaluation, never a per-environment knob.
PHRASE_MODEL_PIN=gemini-3.5-flash-lite
CLIP_MODEL_PIN=gemini-omni-1.1-flash
# When each pin was settled (UTC ISO-8601); moves with a qualified replacement.
PHRASE_MODEL_PINNED_AT=2026-10-12T00:00:00+00:00
CLIP_MODEL_PINNED_AT=2026-10-12T00:00:00+00:00
# Secret — local placeholder only.
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Payments (RevenueCat) and store products (FEAT-013) ---------------------
# RevenueCat wraps StoreKit and Play Billing (D-008), so no card data reaches the
# product (NFR-027): the client SDK buys, RevenueCat grants the entitlement, and
# the signed webhook reconciles it (C-019). Prices are store-managed and localized
# (monetization.md "Payment & Billing"), so only the identifiers and the store
# product catalog are declared here — never a price.
#
# Secrets — local placeholders only; in the cloud both come from Secret Manager
# and are mounted on the entitlement service alone.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Public client SDK keys, one per store. They ship inside the app bundle like the
# Firebase client config: identifiers, not credentials. The reader app's build
# path bakes them in — this key per store, the entitlement and offering below, and
# the PRODUCT_* identifiers — as `--dart-define` values (`ci/build_app.sh`, run by
# `make build` and `make bundle`), so a build carries the store client
# configuration. The RevenueCat secrets above are never a build input.
REVENUECAT_PUBLIC_SDK_KEY_APP_STORE=
REVENUECAT_PUBLIC_SDK_KEY_PLAY_STORE=
# The entitlement a Pro subscription grants and the offering the Paywall reads its
# packages from (screens/04-paywall.md).
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_OFFERING_ID=default
# Store product identifiers (monetization.md "Pricing Tiers"): the Pro
# subscription — monthly and annual — and the one-time lookup top-up. The client
# offers them; a purchase records the identifier (schema.md Purchase.productId)
# and its kind, subscription or topup (C-019).
PRODUCT_PRO_MONTHLY=com.scenova.pro.monthly
PRODUCT_PRO_ANNUAL=com.scenova.pro.annual
PRODUCT_TOPUP_LOOKUPS=com.scenova.topup.lookups20
# What each tier grants (monetization.md "Pricing Tiers"), read by the entitlement
# service (FEAT-013): the Free and Pro monthly allowances, the lookups a top-up
# adds, and the 7-day Pro trial. A pricing change is a change here, not in code;
# `make env` holds these values in step with infra/terraform.
ENTITLEMENT_FREE_LOOKUPS=20
ENTITLEMENT_PRO_LOOKUPS=50
ENTITLEMENT_TOPUP_LOOKUPS=20
ENTITLEMENT_TRIAL_DAYS=7

# --- Analytics ---------------------------------------------------------------
# Sink identifier; raw events carry no personal data.
ANALYTICS_EVENT_STORE=
ANALYTICS_CONSENT_GATED_EVENTS=lookup_started,clip_played,history_viewed

# --- Push notifications (Firebase Cloud Messaging) ----------------------------
# The notification service delivers the clip-ready notice (FEAT-008) to the
# device token the client registered (C-008). The provider is Firebase Cloud
# Messaging behind the Firebase project already used for identity
# (FIREBASE_PROJECT_ID). A send is authorized by a short-lived OAuth 2.0 token
# from Application Default Credentials, so there is no secret here; in the cloud
# the runtime service account is granted the send role and no other service is.
PUSH_PROVIDER=firebase
PUSH_FCM_BASE_URL=https://fcm.googleapis.com

# --- Review console (FEAT-015) ------------------------------------------------
# The operator-only web console (apps/console). It authenticates against the same
# Firebase project as the reader client — the project the services verify ID
# tokens against — so CONSOLE_FIREBASE_PROJECT_ID must equal GCP_PROJECT_ID, and
# `make env` fails if it diverges; a mismatch would have the console mint tokens
# the gateway refuses.
#
# The Firebase *client* config below is a public project identifier, not a
# credential: it ships inside the web bundle the way the reader app's does.
# Operator access is gated by the curator role and multi-factor authentication at
# sign-in (NFR-020), never by hiding these values. On Firebase Hosting the
# console reads the same config at runtime from /__/firebase/init.json; the
# values here are what a local `flutter run -d chrome` and the CI build use, and
# an empty value means "take it from the Hosting runtime config".
CONSOLE_FIREBASE_PROJECT_ID=scenova-hq
CONSOLE_FIREBASE_AUTH_DOMAIN=scenova-hq.firebaseapp.com
CONSOLE_FIREBASE_API_KEY=
CONSOLE_FIREBASE_APP_ID=
CONSOLE_FIREBASE_MESSAGING_SENDER_ID=
# The public entry point the console calls: the gateway, which authenticates the
# operator session and carries the review endpoints (C-014, C-015, C-016). The
# local default is the gateway `make boot` starts.
CONSOLE_REVIEW_API_BASE_URL=http://localhost:8080
# Local port the built console bundle is served on (`make boot`).
CONSOLE_PORT=8088

# --- Feature flags (release.md Rollout Phases) -------------------------------
# Runtime kill switches. Cloud values are the source of truth per environment.
# `make flag ENV=… FLAG=… VALUE=false` flips one without a new image; the
# per-environment tfvars is reconciled after. `FLAG_ENABLE_PAID_TIER` is the
# paid-tier kill switch: off reverts every reader to Free and hides the Paywall,
# leaving the shared library available (release.md).
FLAG_ENABLE_CLIP_VIEW=false
FLAG_ENABLE_GENERATION=false
FLAG_ENABLE_PHRASE_CLIP=false
FLAG_ENABLE_OFFLINE_HISTORY=false
FLAG_ENABLE_PAID_TIER=false
FLAG_SERVE_SEEDED_LIBRARY=true

# --- Local ports (docker-compose / make boot) --------------------------------
GATEWAY_PORT=8080
LOOKUP_PORT=8081
PIPELINE_PORT=8082
LIBRARY_PORT=8083
ENTITLEMENT_PORT=8084
FEEDBACK_PORT=8085
ANALYTICS_PORT=8086
NOTIFICATION_PORT=8087
MODEL_PORT=8090
